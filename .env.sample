# ============================================================================
# CPCCU — ENVIRONMENT TEMPLATE
# ============================================================================
# THIS IS A REAL, LOADABLE DOTENV FILE. Every variable below is written as
# `KEY=` with an EMPTY value, so copying it to `.env.local` produces a file Next
# will actually load, and every variable the server reads is visibly PRESENT with
# nothing in it.
#
# It used to be prose with one real `KEY=value` line and the other 13 variables
# merely NAMED, which meant a copy-paste produced a `.env` Next loaded with
# nothing in it and no indication that thirteen secrets were missing. The names
# are still documented here — as `#` comments — so nothing was lost.
#
# NO SECRET HAS A DEFAULT, AND THAT IS DELIBERATE. A value that a developer can
# copy out of a committed file becomes a value that ships: a plausible default
# signing key means every deployment that forgot to override it shares a secret
# with the whole internet. Values belong in the deployment platform's
# environment-variable store (Vercel: Project → Settings → Environment
# Variables) and, locally, in a `.env.local` that is gitignored.
#
# Only FOUR of these are strictly REQUIRED before the server foundation will
# authenticate or persist anything (`env.js` validates them lazily, on first
# use): `ACCESS_TOKEN_SECRET`, `REFRESH_TOKEN_SECRET`, `PASSWORD_TOKEN_SECRET`,
# `MONGODB_URI`. The rest are required by the specific feature that reads them,
# and each is labelled below with which one that is.
# ============================================================================

# --- Client -------------------------------------------------------------------
# THERE IS NO CLIENT-SIDE API BASE URL VARIABLE TO FILL IN, and that is not a
# gap in this template. The API is SAME-ORIGIN: the app serves its own backend
# from 53 route handlers under `src/app/api/**`, and the base path is the
# hard-coded relative literal `/api/v1` (see `src/services/baseApi.js`).
#
# `NEXT_PUBLIC_API_BASE_URL` was DELETED rather than left here as a blank:
#   - `NEXT_PUBLIC_*` is INLINED AT BUILD TIME, so setting it here required a
#     rebuild and could never have been a live fix; and
#   - the old code read it with `||`, so a blank value — exactly what this
#     template would have produced — fell through to a hard-coded cross-origin
#     `http://localhost:5000/api/v1` in production. A blank here was therefore
#     WORSE than no line here, which is the opposite of what a template that
#     writes `KEY=` for everything else implies.
#
# Do not add it back to point the client at another host: this app's
# same-origin cookie and CSRF design (`src/lib/server/request.js`) depends on
# there being one origin, and changing that needs its own review.
#
# The `NEXT_PUBLIC_*` names still present below are NOT API URLs. Both are read
# on the SERVER by the CSRF origin allow-list in `request.js`, to seed the set
# of origins a cross-site request is allowed to come from.

# --- Database -----------------------------------------------------------------
# `env.js` REQUIRED. Without it `db.js` string-concatenates into the nonsense
# host `"undefined/CPCCU"` and the failure surfaces as a DNS error with nothing
# pointing at the cause.
MONGODB_URI=

# --- Auth: signing secrets ----------------------------------------------------
# `ACCESS_TOKEN_SECRET`, `REFRESH_TOKEN_SECRET` and `PASSWORD_TOKEN_SECRET` are
# `env.js` REQUIRED. Each must be a long random string and each must be
# DIFFERENT from the others: reusing one key across three token types means a
# token minted for one purpose verifies for the others.
#
# Generate one with: `openssl rand -base64 48`
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
PASSWORD_TOKEN_SECRET=

# --- Auth: token lifetimes (jsonwebtoken `expiresIn`) ---------------------------
# These are pass-through values, so the strings jsonwebtoken accepts are valid
# here ("15m", "7d", "3600", …). `ACCESS_TOKEN_EXPIRE` is load-bearing in a way
# that is easy to miss: the transparent-refresh path in `auth.js` only works
# because a short-lived access token is transparently exchanged for a new one.
# Removing it, or setting it huge, changes the failure mode from "users are
# silently refreshed" to "every user is hard-logged-out"; setting it very short
# changes it to "a refresh round trip on nearly every request".
ACCESS_TOKEN_EXPIRE=
REFRESH_TOKEN_EXPIRE=
PASSWORD_TOKEN_EXPIRE=

# --- Cloudinary (image upload / delete) ----------------------------------------
# `CLOUDINARY_CLOUD_NAME`, `CLOUDINARY_API_KEY` and `CLOUDINARY_API_SECRET` are
# read by DESTRUCTURING in `cloudinary.js`, so a `process.env.NAME` grep misses
# the latter two. All three are required together; the uploader validates on
# first call rather than at module load, so a missing one fails the one request
# that needs it instead of the build.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used ONLY by the UNSIGNED upload path (`adminContent.controller.js` reads it
# too). Note that the admin upload handler currently honours a
# caller-supplied `uploadPreset` over this value — a recorded finding (M4), not
# a documented feature.
CLOUDINARY_UPLOAD_PRESET=

# --- Transactional email (Resend) ---------------------------------------------
# `RESEND_API_KEY` authenticates outbound OTP, reset and welcome mail. The Resend
# client is constructed LAZILY in `sendEmail.js` precisely so a missing key
# cannot break a module import; it fails on first send instead.
RESEND_API_KEY=

# `WEB_DOMAIN` is used for two different things: `sentOtp.js` reads it to build
# the host of a password-reset link, and `request.js` reads it as a seed of the
# CSRF origin allow-list. A wrong or missing value here means reset emails point
# at the wrong host, and cross-site requests from the real site are 403'd.
# Supply the bare origin, with scheme and no trailing slash, e.g.
# `https://cpccu.club`.
WEB_DOMAIN=

# --- CSRF origin allow-list ---------------------------------------------------
# Read by `request.js` through `process.env[name]`, so it is invisible to a
# dot-access grep.
#
# A SINGLE origin, used as a seed: its apex and `www.` siblings are added
# automatically, so listing only one half of a pair is not a mistake.
NEXT_PUBLIC_SITE_URL=

# Comma-separated, for hosts that are genuinely neither. ADDITIVE ONLY: it
# cannot REMOVE a configured domain, and it cannot make a bare
# `Sec-Fetch-Site: same-site` request acceptable unless the caller actually sends
# one of these origins. It exists so that adding a staging or preview host is an
# environment-variable change rather than a pull request against a
# security-critical allow-list.
EXTRA_ALLOWED_ORIGINS=

# --- Error reporting ----------------------------------------------------------
# `errors.js` decides whether an unhandled 500 returns its RAW message or the
# generic "Internal Server Error" to the client. The default is
# `NODE_ENV === 'production'`, but `NODE_ENV` is set by the BUILD and by the
# platform, not by this app — so a real host that is built or run without
# `NODE_ENV=production` serves production data while silently opening internal
# detail (connection strings, file paths, driver text) to callers.
#
# Set to `true` to FORCE raw messages regardless of `NODE_ENV` (the live-debug
# escape hatch), or to `false` to FORCE redaction on a host that is not
# reporting itself as production. Leave EMPTY to keep the `NODE_ENV` default.
VERBOSE_ERRORS=

# --- Admin panel: GitHub contributor sync --------------------------------------
# Read only by `adminContent.controller.js`, so it is not needed by any
# non-admin route. It authenticates the GitHub API call that regenerates the
# contributor list; unauthenticated GitHub requests are heavily rate-limited and
# would fail intermittently.
CONTRIBUTOR_GITHUB_TOKEN=

# --- Bootcamp leaderboard (Google Sheets) --------------------------------------
# Read only by `bootcampLeaderboard.controller.js`. `GOOGLE_SHEETS_API_KEY`
# authenticates the Sheets API and `BOOTCAMP_SHEET_ID` names the sheet; both are
# needed together and neither has a default.
GOOGLE_SHEETS_API_KEY=
BOOTCAMP_SHEET_ID=

# ============================================================================
# NOT LISTED ABOVE, BUT READ BY THE SERVER CODE: `NODE_ENV`
# ============================================================================
# `errors.js`, `auth.js` and `constants.js` all branch on it. It is set by
# Next.js (`next build` inlines `production`) and by the deployment platform —
# do NOT set it by hand in this file, and do not set it to `production`
# locally: the non-production branch is the only thing that returns a real
# error message during debugging. It is called out here so the accounting of
# every variable `src/lib/server/**` reads stays complete. If you need to force
# one direction or the other on a real host, use `VERBOSE_ERRORS` above, which
# is the purpose-built control for exactly that.
